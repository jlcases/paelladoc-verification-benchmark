diff --git a/generate_api_routes.js b/generate_api_routes.js
new file mode 100644
index 0000000..3ca5da7
--- /dev/null
+++ b/generate_api_routes.js
@@ -0,0 +1,91 @@
+const fs = require('fs');
+const path = require('path');
+
+/**
+ * Scans src/app/api for route handlers and emits a typed module listing every
+ * real API route path, so /api/health can report reality instead of a
+ * hand-maintained (and perpetually stale) array.
+ *
+ * Runs automatically before every build via the "prebuild" npm script. Safe to
+ * run by hand too:  node generate_api_routes.js
+ *
+ * Paths are resolved from __dirname (this file's location), so the result does
+ * not depend on the current working directory. We emit committed source — not a
+ * runtime filesystem scan — because `output: 'standalone'` does not copy
+ * src/app/** into the deployed bundle, so a runtime scan would see nothing.
+ */
+
+const API_DIR = path.join(__dirname, 'src', 'app', 'api');
+const OUT_FILE = path.join(__dirname, 'src', 'lib', 'api-routes.generated.ts');
+
+const ROUTE_FILE = /^route\.(t|j)sx?$/;
+
+// Walk the app/api tree. A directory maps to a real route iff it directly
+// contains a route handler file. Route groups "(group)" and parallel-route
+// slots "@slot" are transparent to the URL; dynamic segments ("[id]") are kept
+// verbatim. (None exist today, but discovery should not silently drop them.)
+function collect(dir, segments, routes) {
+  let entries;
+  try {
+    entries = fs.readdirSync(dir, { withFileTypes: true });
+  } catch {
+    return;
+  }
+
+  if (entries.some((e) => e.isFile() && ROUTE_FILE.test(e.name))) {
+    routes.push('/api' + (segments.length ? '/' + segments.join('/') : ''));
+  }
+
+  for (const entry of entries) {
+    if (!entry.isDirectory()) continue;
+    const name = entry.name;
+    const transparent =
+      (name.startsWith('(') && name.endsWith(')')) || name.startsWith('@');
+    collect(
+      path.join(dir, name),
+      transparent ? segments : [...segments, name],
+      routes
+    );
+  }
+}
+
+function main() {
+  const routes = [];
+  collect(API_DIR, [], routes);
+  const unique = [...new Set(routes)].sort();
+
+  // Never clobber the committed file with an empty list (e.g. if the tree moved
+  // and the scan found nothing) — keep the last known-good list instead.
+  if (unique.length === 0) {
+    console.warn('[generate_api_routes] no routes found; keeping existing file');
+    return;
+  }
+
+  const body = unique.map((r) => `  ${JSON.stringify(r)},`).join('\n');
+  const contents = `/* eslint-disable */
+// AUTO-GENERATED — DO NOT EDIT BY HAND.
+// Source of truth: the route.ts handlers under src/app/api/.
+// Regenerate with \`node generate_api_routes.js\` (runs automatically via the
+// "prebuild" npm script before every \`npm run build\`).
+
+export const API_ROUTES: string[] = [
+${body}
+];
+`;
+
+  fs.writeFileSync(OUT_FILE, contents);
+  console.log(
+    `Generated ${unique.length} API routes -> ${path.relative(__dirname, OUT_FILE)}`
+  );
+}
+
+try {
+  main();
+} catch (err) {
+  // Route discovery must never break the build; fall back to the committed file.
+  console.warn(
+    '[generate_api_routes] skipped:',
+    err && err.message ? err.message : err
+  );
+  process.exit(0);
+}
