+import { NextResponse } from 'next/server';
+import fs from 'fs';
+import path from 'path';
+
+function getApiRoutes(dir: string, baseDir: string): string[] {
+  const routes: string[] = [];
+  const entries = fs.readdirSync(dir, { withFileTypes: true });
+
+  for (const entry of entries) {
+    const fullPath = path.join(dir, entry.name);
+    if (entry.isDirectory()) {
+      routes.push(...getApiRoutes(fullPath, baseDir));
+    } else if (entry.name === 'route.ts') {
+      const relativePath = path.relative(baseDir, fullPath);
+      const routePath =
+        '/api/' + relativePath.replace(/\\/g, '/').replace('/route.ts', '');
+      if (routePath !== '/api/health') {
+        routes.push(routePath);
+      }
+    }
+  }
+
+  return routes.sort();
+}
+
+export async function GET() {
+  const apiDir = path.join(process.cwd(), 'src', 'app', 'api');
+  let endpoints: string[] = [];
+
+  try {
+    endpoints = getApiRoutes(apiDir, apiDir);
+  } catch {
+    // Fallback to empty list if filesystem is not available
+  }
+
+  return NextResponse.json({
+    status: 'operational',
+    platform: 'OSIRIS',
+    version: '1.0.0',
+    uptime: process.uptime ? Math.round(process.uptime()) : 0,
+    timestamp: new Date().toISOString(),
+    endpoints,
+  });
+}
