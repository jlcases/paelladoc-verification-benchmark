+  // is matched case-insensitively. When both are present a feed must match
+  // both to be included.
+  const countries = parseFilter(searchParams.get('country'), (s) => s.toUpperCase());
+  const categories = parseFilter(searchParams.get('category'), (s) => s.toLowerCase());
+
+  const feeds = LIVE_FEEDS.filter((feed) =>
+    (!countries || countries.includes(feed.country)) &&
+    (!categories || categories.includes(feed.category))
+  );
