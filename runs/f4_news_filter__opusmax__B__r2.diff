-export async function GET() {
+/**
+ * Parse a `?key=a,b,c` query value into a normalized list of filter terms,
+ * or null when the param is absent/empty. `transform` canonicalizes each term
+ * so matching is case-insensitive (countries → upper, categories → lower).
+ */
+function parseFilter(value: string | null, transform: (s: string) => string): string[] | null {
+  if (!value) return null;
+  const terms = value.split(',').map((v) => transform(v.trim())).filter(Boolean);
+  return terms.length > 0 ? terms : null;
+}
