+function normalizeFilter(value: string | null) {
+  const normalized = value?.trim().toLowerCase();
+  return normalized || null;
+}
+
+export async function GET(request: NextRequest) {
+  const country = normalizeFilter(request.nextUrl.searchParams.get('country'));
+  const category = normalizeFilter(request.nextUrl.searchParams.get('category'));
+  const feeds = country || category
+    ? LIVE_FEEDS.filter((feed) => {
+        const countryMatches = !country || feed.country.toLowerCase() === country;
+        const categoryMatches = !category || feed.category.toLowerCase() === category;
+
+        return countryMatches && categoryMatches;
+      })
+    : LIVE_FEEDS;
+
+  return NextResponse.json({
+    feeds,
+    total: feeds.length,
+    categories: ['mainstream', 'government', 'finance', 'conflict', 'state'],
+    timestamp: new Date().toISOString(),
+  }, {
     headers: { 'Cache-Control': 'public, s-maxage=86400, stale-while-revalidate=172800' },
   });
