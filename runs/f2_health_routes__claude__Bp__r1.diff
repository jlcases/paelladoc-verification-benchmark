+function scanApiRoutes(): string[] {
+  const apiDir = path.join(process.cwd(), 'src', 'app', 'api');
+  const entries = fs.readdirSync(apiDir, { recursive: true, encoding: 'utf8' }) as string[];
+  return entries
+    .filter((e) => e === 'route.ts' || e.endsWith(`${path.sep}route.ts`) || e.endsWith('/route.ts'))
+    .map((e) => {
+      const dir = path.dirname(e);
+      const normalized = dir.split(path.sep).join('/');
+      return `/api/${normalized}`;
+    })
+    .sort();
+}
 
