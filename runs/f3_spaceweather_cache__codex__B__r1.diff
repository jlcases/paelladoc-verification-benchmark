+import { NextResponse } from 'next/server';
+
+/**
+ * OSIRIS — Space Weather API
+ * Fetches real-time solar activity from NOAA Space Weather Prediction Center
+ * FREE — No API key required
+ * Data: Kp index (geomagnetic), solar flares, CME alerts
+ */
+
+type SpaceWeatherAlert = {
+  id: string;
+  issue_datetime?: string;
+  message: string;
+};
+
+type SpaceWeatherFlare = {
+  class: string;
+  begin?: string;
+  peak?: string;
+  end?: string;
+};
+
+type SpaceWeatherPayload = {
+  kp_index: number;
+  storm_level: string;
+  storm_color: string;
+  kp_timestamp: string;
+  alerts: SpaceWeatherAlert[];
+  solar_flares: SpaceWeatherFlare[];
+  timestamp: string;
+  error?: string;
+};
+
+type SpaceWeatherCacheEntry = {
+  data: SpaceWeatherPayload;
+  expiresAt: number;
+};
+
+const SPACE_WEATHER_CACHE_TTL_MS = 60_000;
+const NOAA_FETCH_TIMEOUT_MS = 8_000;
+
+let spaceWeatherCache: SpaceWeatherCacheEntry | null = null;
+let spaceWeatherRefresh: Promise<SpaceWeatherPayload> | null = null;
+
+function asRecord(value: unknown): Record<string, unknown> | null {
+  return value !== null && typeof value === 'object' ? value as Record<string, unknown> : null;
+}
+
+function asString(value: unknown): string {
+  return typeof value === 'string' ? value : '';
+}
+
+function asNumber(value: unknown): number {
+  if (typeof value === 'number') return value;
+  if (typeof value === 'string') return parseFloat(value) || 0;
+  return 0;
+}
+
+async function fetchNoaaJson(url: string): Promise<unknown> {
+  const response = await fetch(url, {
+    cache: 'no-store',
+    signal: AbortSignal.timeout(NOAA_FETCH_TIMEOUT_MS),
+  });
+  return response.json();
+}
+
+function describeStorm(kpIndex: number): { stormLevel: string; stormColor: string } {
+  if (kpIndex >= 8) return { stormLevel: 'Extreme (G5)', stormColor: '#FF1744' };
+  if (kpIndex >= 7) return { stormLevel: 'Severe (G4)', stormColor: '#FF3D3D' };
+  if (kpIndex >= 6) return { stormLevel: 'Strong (G3)', stormColor: '#FF9500' };
+  if (kpIndex >= 5) return { stormLevel: 'Moderate (G2)', stormColor: '#FFD700' };
+  if (kpIndex >= 4) return { stormLevel: 'Minor (G1)', stormColor: '#FFD700' };
+  if (kpIndex >= 3) return { stormLevel: 'Unsettled', stormColor: '#D4AF37' };
+  return { stormLevel: 'Quiet', stormColor: '#00E676' };
+}
+
+async function loadSpaceWeatherData(): Promise<SpaceWeatherPayload> {
+  const [kpRes, alertsRes, flareRes] = await Promise.allSettled([
+    fetchNoaaJson('https://services.swpc.noaa.gov/json/planetary_k_index_1m.json'),
+    fetchNoaaJson('https://services.swpc.noaa.gov/json/alerts.json'),
+    fetchNoaaJson('https://services.swpc.noaa.gov/json/goes/primary/xray-flares-latest.json'),
+  ]);
+
+  // Latest Kp index (geomagnetic storm indicator)
+  let kpIndex = 0;
+  let kpTimestamp = '';
+  if (kpRes.status === 'fulfilled' && Array.isArray(kpRes.value) && kpRes.value.length > 0) {
+    const latest = asRecord(kpRes.value[kpRes.value.length - 1]);
+    kpIndex = asNumber(latest?.kp_index ?? latest?.Kp);
+    kpTimestamp = asString(latest?.time_tag);
+  }
+
+  const { stormLevel, stormColor } = describeStorm(kpIndex);
+
+  // Recent alerts
+  const alerts: SpaceWeatherAlert[] = [];
+  if (alertsRes.status === 'fulfilled' && Array.isArray(alertsRes.value)) {
+    for (const [index, alert] of alertsRes.value.slice(0, 10).entries()) {
+      const record = asRecord(alert);
+      if (!record) continue;
+      alerts.push({
+        id: asString(record.product_id) || `alert-${Date.now()}-${index}`,
+        issue_datetime: asString(record.issue_datetime) || undefined,
+        message: asString(record.message).substring(0, 200),
+      });
+    }
+  }
+
+  // Recent solar flares
+  const flares: SpaceWeatherFlare[] = [];
+  if (flareRes.status === 'fulfilled' && Array.isArray(flareRes.value)) {
+    for (const flare of flareRes.value.slice(0, 5)) {
+      const record = asRecord(flare);
+      const maxClass = asString(record?.max_class);
+      if (!maxClass) continue;
+      flares.push({
+        class: maxClass,
+        begin: asString(record?.begin_time) || undefined,
+        peak: asString(record?.max_time) || undefined,
+        end: asString(record?.end_time) || undefined,
+      });
+    }
+  }
+
+  return {
+    kp_index: kpIndex,
+    storm_level: stormLevel,
+    storm_color: stormColor,
+    kp_timestamp: kpTimestamp,
+    alerts,
+    solar_flares: flares,
+    timestamp: new Date().toISOString(),
+  };
+}
+
+async function getCachedSpaceWeatherData(): Promise<{ data: SpaceWeatherPayload; cacheStatus: string }> {
+  const now = Date.now();
+  if (spaceWeatherCache && spaceWeatherCache.expiresAt > now) {
+    return { data: spaceWeatherCache.data, cacheStatus: 'hit' };
+  }
+
+  if (spaceWeatherRefresh) {
+    return { data: await spaceWeatherRefresh, cacheStatus: 'refresh' };
+  }
+
+  const refresh = loadSpaceWeatherData().then((data) => {
+    spaceWeatherCache = {
+      data,
+      expiresAt: Date.now() + SPACE_WEATHER_CACHE_TTL_MS,
+    };
+    return data;
+  }).finally(() => {
+    spaceWeatherRefresh = null;
+  });
+
+  spaceWeatherRefresh = refresh;
+  return { data: await refresh, cacheStatus: 'miss' };
+}
+
+export async function GET() {
+  try {
+    const { data, cacheStatus } = await getCachedSpaceWeatherData();
+
+    return NextResponse.json(data, {
+      headers: {
+        'Cache-Control': 'no-store',
+        'X-Space-Weather-Cache': cacheStatus,
+      },
+    });
+  } catch (error) {
+    console.error('Space Weather API error:', error);
+    return NextResponse.json({
+      kp_index: 0, storm_level: 'Unknown', storm_color: '#555',
+      alerts: [], solar_flares: [], error: 'Failed to fetch space weather data',
+    }, { status: 500 });
+  }
+}
