 import { NextResponse } from 'next/server';
+import { readdirSync, statSync } from 'fs';
+import { join } from 'path';
+
+function scanApiRoutes(dir: string, prefix: string = '/api'): string[] {
+  const endpoints: string[] = [];
+
+  try {
+    const entries = readdirSync(dir, { withFileTypes: true });
+
+    for (const entry of entries) {
+      const fullPath = join(dir, entry.name);
+
+      if (entry.isDirectory()) {
+        const routeFile = join(fullPath, 'route.ts');
+        const routeJsFile = join(fullPath, 'route.js');
+
+        try {
+          statSync(routeFile);
+          endpoints.push(`${prefix}/${entry.name}`);
+        } catch {
+          try {
+            statSync(routeJsFile);
+            endpoints.push(`${prefix}/${entry.name}`);
+          } catch {
+            // No route file at this level, scan subdirectories
+            const subEndpoints = scanApiRoutes(fullPath, `${prefix}/${entry.name}`);
+            endpoints.push(...subEndpoints);
+          }
+        }
+      }
+    }
+  } catch (error) {
+    // Gracefully fall back on scan failure
+    console.error('Failed to scan API routes:', error);
+  }
+
+  return endpoints.sort();
+}
 
 export async function GET() {
+  const apiDir = join(process.cwd(), 'src/app/api');
+  const endpoints = scanApiRoutes(apiDir);
+
   return NextResponse.json({
     status: 'operational',
     platform: 'OSIRIS',
     version: '1.0.0',
     uptime: process.uptime ? Math.round(process.uptime()) : 0,
     timestamp: new Date().toISOString(),
