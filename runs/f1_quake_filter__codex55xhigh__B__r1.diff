+ * Fetches real-time seismic events from USGS (last 24h, M2.5+)
+ * No API key required
+ */
+
+const MIN_MAGNITUDE_QUERY_KEYS = ['minMagnitude', 'minMag', 'min_magnitude'];
+
+function getMinMagnitude(searchParams: URLSearchParams): number | null {
+  const rawValue = MIN_MAGNITUDE_QUERY_KEYS
+    .map(key => searchParams.get(key))
+    .find(value => value !== null && value.trim() !== '');
+
+  if (!rawValue) return null;
+
+  const value = Number(rawValue);
+  return Number.isFinite(value) ? Math.max(0, value) : null;
+}
