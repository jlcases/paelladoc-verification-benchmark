-export async function GET() {
+// Parse a query param into a normalized, lower-cased set of filter values.
+// Supports comma-separated lists (e.g. ?country=US,GB), matching the
+// convention used by the other OSIRIS feed routes.
+function parseFilter(raw: string | null): Set<string> {
+  return new Set(
+    (raw ?? '')
+      .split(',')
+      .map((v) => v.trim().toLowerCase())
+      .filter(Boolean)
+  );
+}
+
+export async function GET(request: Request) {
+  const { searchParams } = new URL(request.url);
+  const countries = parseFilter(searchParams.get('country'));
