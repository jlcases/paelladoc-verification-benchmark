+  const feeds = LIVE_FEEDS.filter((feed) => {
+    if (countries.size && !countries.has(feed.country.toLowerCase())) return false;
+    if (categories.size && !categories.has(feed.category.toLowerCase())) return false;
+    return true;
+  });
+
   return NextResponse.json({
