+import { NextResponse } from 'next/server';
+
+/**
+ * OSIRIS — Earthquake Data API
+ * Fetches real-time seismic events from USGS (last 24h, M2.5+)
+ * No API key required
+ */
+
+export const dynamic = 'force-dynamic';
+
+const MIN_MAGNITUDE_PARAMS = ['minMagnitude', 'minMag', 'min_magnitude'];
+
+type UsgsFeature = {
+  id?: string;
+  geometry?: {
+    coordinates?: number[];
+  };
+  properties?: {
+    mag?: number | null;
+    place?: string;
+    time?: number;
+    url?: string;
+    tsunami?: number;
+    type?: string;
+    felt?: number | null;
+    alert?: string | null;
+  };
+};
+
+type UsgsResponse = {
+  features?: UsgsFeature[];
+};
+
+function getMinMagnitude(searchParams: URLSearchParams): number | null {
+  for (const param of MIN_MAGNITUDE_PARAMS) {
+    const value = searchParams.get(param);
+    if (value === null || value.trim() === '') continue;
+
+    const minMagnitude = Number(value);
+    return Number.isFinite(minMagnitude) ? minMagnitude : null;
+  }
+
+  return null;
+}
+
