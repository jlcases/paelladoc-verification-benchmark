+import { NextResponse } from 'next/server';
+
+/**
+ * OSIRIS — Earthquake Data API
+ * Fetches real-time seismic events from USGS (last 24h, M2.5+)
+ * No API key required
+ */
+
+const DEFAULT_MIN_MAGNITUDE = 2.5;
+const MIN_MAGNITUDE_PARAMS = ['minMagnitude', 'minMag', 'min_magnitude', 'minmagnitude', 'minmag'];
+
+type UsgsEarthquakeFeature = {
+  id?: string;
+  geometry?: {
+    coordinates?: unknown[];
+  };
+  properties?: {
+    mag?: unknown;
+    place?: unknown;
+    time?: unknown;
+    url?: unknown;
+    tsunami?: unknown;
+    type?: unknown;
+    felt?: unknown;
+    alert?: unknown;
+  };
+};
+
+type Earthquake = {
+  id?: string;
+  lat: number;
+  lng: number;
+  depth: number;
+  magnitude: number;
+  place: unknown;
+  time: unknown;
+  url: unknown;
+  tsunami: unknown;
+  type: unknown;
+  felt: unknown;
+  alert: unknown;
+};
+
+function parseFiniteNumber(value: unknown): number | null {
+  if (typeof value === 'number') {
+    return Number.isFinite(value) ? value : null;
+  }
+
+  if (typeof value === 'string' && value.trim() !== '') {
+    const parsed = Number(value);
+    return Number.isFinite(parsed) ? parsed : null;
+  }
+
+  return null;
+}
+
+function parseMinMagnitude(searchParams: URLSearchParams): number | null {
+  const rawValue = MIN_MAGNITUDE_PARAMS.map(param => searchParams.get(param)).find(value => value !== null);
+
+  if (rawValue === undefined || rawValue === null || rawValue.trim() === '') {
+    return DEFAULT_MIN_MAGNITUDE;
+  }
+
+  return parseFiniteNumber(rawValue);
+}
+
+function toEarthquake(feature: UsgsEarthquakeFeature): Earthquake | null {
+  const coords = Array.isArray(feature.geometry?.coordinates) ? feature.geometry.coordinates : [];
+  const props = feature.properties || {};
+  const magnitude = parseFiniteNumber(props.mag);
+
+  if (magnitude === null) {
+    return null;
+  }
+
+  return {
+    id: feature.id,
+    lat: parseFiniteNumber(coords[1]) ?? 0,
+    lng: parseFiniteNumber(coords[0]) ?? 0,
+    depth: parseFiniteNumber(coords[2]) ?? 0,
+    magnitude,
+    place: props.place,
+    time: props.time,
+    url: props.url,
+    tsunami: props.tsunami,
+    type: props.type,
+    felt: props.felt,
+    alert: props.alert,
+  };
+}
