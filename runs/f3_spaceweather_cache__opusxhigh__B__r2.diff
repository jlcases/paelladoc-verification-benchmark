diff --git a/src/app/api/space-weather/route.ts b/src/app/api/space-weather/route.ts
index 03b9f6b..9e4c10a 100644
--- a/src/app/api/space-weather/route.ts
+++ b/src/app/api/space-weather/route.ts
@@ -6,19 +6,34 @@ import { NextResponse } from 'next/server';
  * Fetches real-time solar activity from NOAA Space Weather Prediction Center
  * FREE — No API key required
  * Data: Kp index (geomagnetic), solar flares, CME alerts
+ *
+ * Caching: NOAA only refreshes these feeds roughly once a minute, so each
+ * upstream fetch opts into Next.js' Data Cache via `next.revalidate`. Within
+ * the TTL the responses are served from cache instead of re-hitting NOAA,
+ * which collapses bursts of client requests down to (at most) one set of
+ * upstream calls per window. The route handler itself stays dynamic, so the
+ * `timestamp` we return still reflects when the response was served.
+ * (`AbortSignal.timeout` is dropped automatically during background
+ * revalidation, so it does not conflict with caching.)
  */
 
+// Short server-side cache window, in seconds.
+const CACHE_TTL_SECONDS = 60;
+
 export async function GET() {
   try {
     const [kpRes, alertsRes, flareRes] = await Promise.allSettled([
       fetch('https://services.swpc.noaa.gov/json/planetary_k_index_1m.json', {
         signal: AbortSignal.timeout(8000),
+        next: { revalidate: CACHE_TTL_SECONDS },
       }).then(r => r.json()),
       fetch('https://services.swpc.noaa.gov/json/alerts.json', {
         signal: AbortSignal.timeout(8000),
+        next: { revalidate: CACHE_TTL_SECONDS },
       }).then(r => r.json()),
       fetch('https://services.swpc.noaa.gov/json/goes/primary/xray-flares-latest.json', {
         signal: AbortSignal.timeout(8000),
+        next: { revalidate: CACHE_TTL_SECONDS },
       }).then(r => r.json()),
     ]);
 
