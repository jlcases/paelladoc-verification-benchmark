+import { NextResponse } from 'next/server';
+
+/**
+ * OSIRIS — Space Weather API
+ * Fetches real-time solar activity from NOAA Space Weather Prediction Center
+ * FREE — No API key required
+ * Data: Kp index (geomagnetic), solar flares, CME alerts
+ *
+ * A short in-memory cache fronts NOAA so we don't hammer the upstream on every
+ * request. The computed payload is reused within CACHE_TTL_SECONDS; once it
+ * expires the next request refetches from NOAA and refreshes the cache.
+ */
+
+const CACHE_TTL_SECONDS = 60;
+const CACHE_TTL_MS = CACHE_TTL_SECONDS * 1000;
+
+interface SpaceWeatherPayload {
+  kp_index: number;
+  storm_level: string;
+  storm_color: string;
+  kp_timestamp?: string;
+  alerts: any[];
+  solar_flares: any[];
+  timestamp: string;
+  error?: string;
+}
+
+// Module-level cache: survives across requests for the lifetime of the worker.
+let cachedPayload: SpaceWeatherPayload | null = null;
+let cacheExpiresAt = 0;
+
+const cacheControl = `public, s-maxage=${CACHE_TTL_SECONDS}, stale-while-revalidate=${CACHE_TTL_SECONDS * 2}`;
+
+/**
+ * Fetch from NOAA and compute the payload. Returns the payload along with a
+ * flag indicating whether at least one upstream source responded, so callers
+ * can avoid caching a fully-degraded (all-sources-down) result.
+ */
+async function fetchSpaceWeather(): Promise<{ payload: SpaceWeatherPayload; anySuccess: boolean }> {
+  const [kpRes, alertsRes, flareRes] = await Promise.allSettled([
+    fetch('https://services.swpc.noaa.gov/json/planetary_k_index_1m.json', {
+      signal: AbortSignal.timeout(8000),
+    }).then(r => r.json()),
+    fetch('https://services.swpc.noaa.gov/json/alerts.json', {
+      signal: AbortSignal.timeout(8000),
+    }).then(r => r.json()),
+    fetch('https://services.swpc.noaa.gov/json/goes/primary/xray-flares-latest.json', {
+      signal: AbortSignal.timeout(8000),
+    }).then(r => r.json()),
+  ]);
+
+  const anySuccess =
+    kpRes.status === 'fulfilled' ||
+    alertsRes.status === 'fulfilled' ||
+    flareRes.status === 'fulfilled';
+
+  // Latest Kp index (geomagnetic storm indicator)
+  let kpIndex = 0;
+  let kpTimestamp = '';
+  if (kpRes.status === 'fulfilled' && Array.isArray(kpRes.value) && kpRes.value.length > 0) {
+    const latest = kpRes.value[kpRes.value.length - 1];
+    kpIndex = parseFloat(latest.kp_index || latest.Kp || 0);
+    kpTimestamp = latest.time_tag || '';
+  }
+
+  // Storm level from Kp
+  let stormLevel = 'Quiet';
+  let stormColor = '#00E676';
+  if (kpIndex >= 8) { stormLevel = 'Extreme (G5)'; stormColor = '#FF1744'; }
+  else if (kpIndex >= 7) { stormLevel = 'Severe (G4)'; stormColor = '#FF3D3D'; }
+  else if (kpIndex >= 6) { stormLevel = 'Strong (G3)'; stormColor = '#FF9500'; }
+  else if (kpIndex >= 5) { stormLevel = 'Moderate (G2)'; stormColor = '#FFD700'; }
+  else if (kpIndex >= 4) { stormLevel = 'Minor (G1)'; stormColor = '#FFD700'; }
+  else if (kpIndex >= 3) { stormLevel = 'Unsettled'; stormColor = '#D4AF37'; }
+
+  // Recent alerts
+  const alerts: any[] = [];
+  if (alertsRes.status === 'fulfilled' && Array.isArray(alertsRes.value)) {
+    for (const alert of alertsRes.value.slice(0, 10)) {
+      alerts.push({
+        id: alert.product_id || `alert-${Date.now()}`,
+        issue_datetime: alert.issue_datetime,
+        message: (alert.message || '').substring(0, 200),
+      });
+    }
+  }
+
+  // Recent solar flares
+  const flares: any[] = [];
+  if (flareRes.status === 'fulfilled' && Array.isArray(flareRes.value)) {
+    for (const flare of flareRes.value.slice(0, 5)) {
+      if (!flare.max_class) continue;
+      flares.push({
+        class: flare.max_class,
+        begin: flare.begin_time,
+        peak: flare.max_time,
+        end: flare.end_time,
+      });
+    }
+  }
+
+  const payload: SpaceWeatherPayload = {
+    kp_index: kpIndex,
+    storm_level: stormLevel,
+    storm_color: stormColor,
+    kp_timestamp: kpTimestamp,
+    alerts,
+    solar_flares: flares,
+    timestamp: new Date().toISOString(),
+  };
+
+  return { payload, anySuccess };
+}
+
+export async function GET() {
+  const now = Date.now();
+
+  // Serve from cache while it is still fresh — no upstream NOAA calls.
+  if (cachedPayload && now < cacheExpiresAt) {
+    return NextResponse.json(cachedPayload, {
+      headers: { 'Cache-Control': cacheControl },
+    });
+  }
+
+  try {
+    const { payload, anySuccess } = await fetchSpaceWeather();
+
+    // Only cache results that actually came from NOAA, so a total outage
+    // doesn't pin a degraded payload for the whole TTL window.
+    if (anySuccess) {
+      cachedPayload = payload;
+      cacheExpiresAt = now + CACHE_TTL_MS;
+    }
+
+    return NextResponse.json(payload, {
+      headers: { 'Cache-Control': cacheControl },
+    });
+  } catch (error) {
+    console.error('Space Weather API error:', error);
+
+    // Resilience: prefer a stale cached payload over a hard error if we have one.
+    if (cachedPayload) {
+      return NextResponse.json(cachedPayload, {
+        headers: { 'Cache-Control': cacheControl },
+      });
+    }
+
+    return NextResponse.json({
+      kp_index: 0, storm_level: 'Unknown', storm_color: '#555',
+      alerts: [], solar_flares: [], error: 'Failed to fetch space weather data',
+    }, { status: 500 });
+  }
+}
