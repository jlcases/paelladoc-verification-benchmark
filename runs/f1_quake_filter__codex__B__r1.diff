+import { NextResponse } from 'next/server';
+
+/**
+ * OSIRIS — Earthquake Data API
+ * Fetches real-time seismic events from USGS (last 24h, M2.5+)
+ * Optional query: ?minMagnitude=4.5 filters out smaller events
+ * No API key required
+ */
+
+function parseMinimumMagnitude(searchParams: URLSearchParams): number | null {
+  const raw = searchParams.get('minMagnitude') ?? searchParams.get('minMag');
+  if (raw === null || raw.trim() === '') return null;
+
+  const value = Number(raw);
+  return Number.isFinite(value) ? value : Number.NaN;
+}
+
+export async function GET(request: Request) {
+  try {
+    const minMagnitude = parseMinimumMagnitude(new URL(request.url).searchParams);
+    if (Number.isNaN(minMagnitude)) {
+      return NextResponse.json(
+        { earthquakes: [], error: 'minMagnitude must be a valid number' },
+        { status: 400 },
+      );
+    }
+
+    const url = 'https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson';
+    const res = await fetch(url, {
+      signal: AbortSignal.timeout(10000),
     });
 
     if (!res.ok) {
