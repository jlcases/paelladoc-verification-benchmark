+import { NextResponse } from 'next/server';
+import { promises as fs } from 'node:fs';
+import path from 'node:path';
+
+// Reading the route tree depends on Node's `fs`, so pin the Node.js runtime.
+export const runtime = 'nodejs';
+// Re-scan the filesystem on every request so the list stays current at runtime
+// (rather than being frozen into a build-time prerender).
+export const dynamic = 'force-dynamic';
+
+// Matches the App Router route handler files (`route.ts`, `route.js`, ...).
+const ROUTE_FILE = /^route\.(?:ts|tsx|js|jsx|mjs|cjs)$/;
+
+// Used only when the filesystem scan is unavailable (e.g. a standalone deploy
+// that doesn't ship the source tree). Keeps the endpoint responsive and valid.
+const FALLBACK_ENDPOINTS = [
+  '/api/flights',
+  '/api/satellites',
+  '/api/earthquakes',
+  '/api/news',
+  '/api/gdelt',
+  '/api/markets',
+  '/api/frontlines',
+  '/api/region-dossier',
+];
+
+/**
+ * Recursively walk the API route tree, collecting the URL path of every
+ * directory that contains a route handler file. `segments` is the URL path
+ * built up so far (starting at `['api']`).
+ */
+async function collectRoutes(
+  dir: string,
+  segments: string[],
+  out: string[],
+): Promise<void> {
+  const entries = await fs.readdir(dir, { withFileTypes: true });
+
+  // A directory holding a `route.*` file is itself an addressable endpoint.
+  if (entries.some((e) => e.isFile() && ROUTE_FILE.test(e.name))) {
+    out.push('/' + segments.join('/'));
+  }
+
+  for (const entry of entries) {
+    if (!entry.isDirectory()) continue;
+    const name = entry.name;
+
+    // Private folders (`_foo`) are never routable.
+    if (name.startsWith('_')) continue;
+
+    if ((name.startsWith('(') && name.endsWith(')')) || name.startsWith('@')) {
+      // Route groups `(group)` and parallel-route slots `@slot` don't
+      // contribute a segment to the public URL path.
+      await collectRoutes(path.join(dir, name), segments, out);
+    } else {
+      await collectRoutes(path.join(dir, name), [...segments, name], out);
+    }
+  }
+}
+
+/**
+ * Derive the list of `/api/...` endpoints from the App Router source tree.
+ * Returns `null` when the route directory can't be located or read so callers
+ * can fall back gracefully.
+ */
+async function discoverApiEndpoints(): Promise<string[] | null> {
+  const candidates = [
+    path.join(process.cwd(), 'src', 'app', 'api'),
+    path.join(process.cwd(), 'app', 'api'),
+  ];
+
+  for (const base of candidates) {
+    try {
+      const stat = await fs.stat(base);
+      if (!stat.isDirectory()) continue;
+
+      const out: string[] = [];
+      await collectRoutes(base, ['api'], out);
+
+      const endpoints = Array.from(new Set(out))
+        .filter((p) => p.startsWith('/api/'))
+        .sort();
+
+      if (endpoints.length > 0) return endpoints;
+    } catch {
+      // Directory missing or unreadable — try the next candidate.
+    }
+  }
+
+  return null;
+}
+
+export async function GET() {
+  let endpoints = FALLBACK_ENDPOINTS;
+
+  try {
+    const discovered = await discoverApiEndpoints();
+    if (discovered && discovered.length > 0) {
+      endpoints = discovered;
+    }
+  } catch {
+    // Never let a scan failure take down the health check.
+  }
+
+  return NextResponse.json({
+    status: 'operational',
+    platform: 'OSIRIS',
+    version: '1.0.0',
+    uptime: process.uptime ? Math.round(process.uptime()) : 0,
+    timestamp: new Date().toISOString(),
+    endpoints,
+  });
+}
