diff --git a/generate_health_routes.js b/generate_health_routes.js
new file mode 100644
index 0000000..598fddb
--- /dev/null
+++ b/generate_health_routes.js
@@ -0,0 +1,69 @@
+const fs = require('fs');
+const path = require('path');
+
+// Generates the list of App Router route handlers (every `route.*` file) so the
+// /api/health endpoint reflects the real API surface instead of a stale, hand-
+// maintained list. The output is baked into the bundle at build time, which is
+// required because next.config.ts uses `output: 'standalone'` — the `src/` tree
+// is not shipped to production, so the routes cannot be discovered at runtime.
+//
+// Runs automatically before `npm run build` (see the "prebuild" script) and can
+// be run manually with `node generate_health_routes.js`.
+
+const APP_DIR = path.join(__dirname, 'src', 'app');
+const OUT_FILE = path.join(APP_DIR, 'api', 'health', 'routes.generated.ts');
+
+const ROUTE_FILE = /^route\.(ts|tsx|js|jsx)$/;
+
+/** Recursively collect every route handler file under `dir`. */
+function findRouteFiles(dir) {
+  const files = [];
+  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+    const full = path.join(dir, entry.name);
+    if (entry.isDirectory()) {
+      files.push(...findRouteFiles(full));
+    } else if (ROUTE_FILE.test(entry.name)) {
+      files.push(full);
+    }
+  }
+  return files;
+}
+
+/** Convert a route handler file path into its public URL pathname, or null if not routable. */
+function toRoutePath(file) {
+  const segments = path
+    .relative(APP_DIR, path.dirname(file))
+    .split(path.sep)
+    .filter(Boolean);
+
+  // A private folder (`_name`) opts its whole subtree out of routing.
+  if (segments.some((s) => s.startsWith('_'))) return null;
+
+  const urlSegments = segments.filter(
+    // Route groups `(group)` and parallel-route slots `@slot` don't appear in the URL.
+    (s) => !(s.startsWith('(') && s.endsWith(')')) && !s.startsWith('@')
+  );
+
+  return '/' + urlSegments.join('/');
+}
+
+function run() {
+  const routes = Array.from(
+    new Set(findRouteFiles(APP_DIR).map(toRoutePath).filter((r) => r !== null))
+  ).sort();
+
+  const body = routes.map((r) => `  ${JSON.stringify(r)},`).join('\n');
+  const out = `// AUTO-GENERATED FILE — DO NOT EDIT.
+// Generated by generate_health_routes.js (runs via the "prebuild" npm script).
+// Lists every App Router route handler so /api/health reflects the real API surface.
+
+export const API_ROUTES: readonly string[] = [
+${body}
+];
+`;
+
+  fs.writeFileSync(OUT_FILE, out);
+  console.log(`Generated ${routes.length} API routes -> ${path.relative(__dirname, OUT_FILE)}`);
+}
+
+run();
