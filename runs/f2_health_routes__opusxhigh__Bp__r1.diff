+import { NextResponse } from 'next/server';
+import { readdirSync } from 'node:fs';
+import { join } from 'node:path';
+
+// Read the route tree per request rather than baking it in at build time,
+// so the list always reflects the routes actually present on disk.
+export const dynamic = 'force-dynamic';
+
+// Used only when the filesystem scan is unavailable (e.g. the `src` tree is
+// absent in a standalone/serverless bundle). Keeps the route from throwing.
+const FALLBACK_ENDPOINTS = [
+  '/api/flights',
+  '/api/satellites',
+  '/api/earthquakes',
+  '/api/news',
+  '/api/gdelt',
+  '/api/markets',
+  '/api/frontlines',
+  '/api/region-dossier',
+];
+
+// Next.js Route Handlers live in a `route.{js,jsx,ts,tsx,mjs,cjs}` file inside
+// a segment directory; the directory path (relative to `src/app`) is the URL.
+const ROUTE_FILE = /^route\.(?:[mc]?js|jsx|tsx?)$/;
+
+function discoverEndpoints(): string[] {
+  const apiRoot = join(process.cwd(), 'src', 'app', 'api');
+  const endpoints: string[] = [];
+
+  const walk = (dir: string, segments: string[]): void => {
+    const entries = readdirSync(dir, { withFileTypes: true });
+
+    // A handler at this segment means a real `/api/...` endpoint.
+    if (segments.length > 0 && entries.some((e) => e.isFile() && ROUTE_FILE.test(e.name))) {
+      endpoints.push('/api/' + segments.join('/'));
+    }
+
+    for (const entry of entries) {
+      if (entry.isDirectory()) {
+        walk(join(dir, entry.name), [...segments, entry.name]);
+      }
+    }
+  };
+
+  walk(apiRoot, []);
+  return endpoints.sort();
+}
+
+export async function GET() {
+  let endpoints: string[];
+  try {
+    const discovered = discoverEndpoints();
+    endpoints = discovered.length > 0 ? discovered : FALLBACK_ENDPOINTS;
+  } catch {
+    // Never let a failed scan take the health check down.
+    endpoints = FALLBACK_ENDPOINTS;
+  }
+
+  return NextResponse.json({
+    status: 'operational',
+    platform: 'OSIRIS',
+    version: '1.0.0',
+    uptime: process.uptime ? Math.round(process.uptime()) : 0,
+    timestamp: new Date().toISOString(),
+    endpoints,
+  });
+}
