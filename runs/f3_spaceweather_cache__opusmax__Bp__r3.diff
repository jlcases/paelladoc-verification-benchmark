+import { NextResponse } from 'next/server';
+
+/**
+ * OSIRIS — Space Weather API
+ * Fetches real-time solar activity from NOAA Space Weather Prediction Center
+ * FREE — No API key required
+ * Data: Kp index (geomagnetic), solar flares, CME alerts
+ *
+ * A short-lived, in-memory cache shields NOAA from per-request traffic: the
+ * computed payload is reused for CACHE_TTL_SECONDS before we refetch upstream.
+ */
+
+// Keep the TTL short so the data stays fresh while still collapsing bursts of
+// requests into a single upstream round-trip. ~1 minute is the sweet spot.
+const CACHE_TTL_SECONDS = 60;
+const CACHE_TTL_MS = CACHE_TTL_SECONDS * 1000;
+const CACHE_CONTROL = `public, max-age=${CACHE_TTL_SECONDS}, s-maxage=${CACHE_TTL_SECONDS}, stale-while-revalidate=${CACHE_TTL_SECONDS}`;
+
+type SpaceWeatherPayload = {
+  kp_index: number;
+  storm_level: string;
+  storm_color: string;
+  kp_timestamp: string;
+  alerts: any[];
+  solar_flares: any[];
+  timestamp: string;
+};
+
+// Module-scoped cache. Under `output: 'standalone'` this lives for the lifetime
+// of the server process and is shared across every incoming request.
+let cache: { payload: SpaceWeatherPayload; expiresAt: number } | null = null;
+
+export async function GET() {
+  // Serve from cache while it is still warm — no NOAA fetches are issued here.
+  if (cache && cache.expiresAt > Date.now()) {
+    return NextResponse.json(cache.payload, {
+      headers: { 'Cache-Control': CACHE_CONTROL },
+    });
+  }
+
+  try {
+    const { payload, ok } = await loadSpaceWeather();
+
+    // Only cache a payload backed by at least one successful upstream, so a
+    // transient NOAA outage is never pinned for the whole TTL window.
+    if (ok) {
+      cache = { payload, expiresAt: Date.now() + CACHE_TTL_MS };
+      return NextResponse.json(payload, {
+        headers: { 'Cache-Control': CACHE_CONTROL },
+      });
+    }
+
+    // Degraded (every upstream failed) — still respond, but don't cache it.
+    return NextResponse.json(payload, {
+      headers: { 'Cache-Control': 'no-store' },
+    });
+  } catch (error) {
+    console.error('Space Weather API error:', error);
+    return NextResponse.json(
+      {
+        kp_index: 0, storm_level: 'Unknown', storm_color: '#555',
+        alerts: [], solar_flares: [], error: 'Failed to fetch space weather data',
+      },
+      { status: 500, headers: { 'Cache-Control': 'no-store' } }
+    );
+  }
+}
+
+/**
+ * Fetches the three NOAA feeds and normalizes them into the response payload.
+ * Resolves with `ok: false` when every upstream fails so the caller can keep
+ * the existing graceful-degradation behavior without caching empty data.
+ */
+async function loadSpaceWeather(): Promise<{ payload: SpaceWeatherPayload; ok: boolean }> {
+  const [kpRes, alertsRes, flareRes] = await Promise.allSettled([
+    fetch('https://services.swpc.noaa.gov/json/planetary_k_index_1m.json', {
+      signal: AbortSignal.timeout(8000),
+    }).then(r => r.json()),
+    fetch('https://services.swpc.noaa.gov/json/alerts.json', {
+      signal: AbortSignal.timeout(8000),
+    }).then(r => r.json()),
+    fetch('https://services.swpc.noaa.gov/json/goes/primary/xray-flares-latest.json', {
+      signal: AbortSignal.timeout(8000),
+    }).then(r => r.json()),
+  ]);
+
+  // Treat the refresh as usable if any upstream returned data; if all three
+  // rejected we still build a (degraded) payload but flag it as not cacheable.
+  const ok = [kpRes, alertsRes, flareRes].some(r => r.status === 'fulfilled');
+
+  // Latest Kp index (geomagnetic storm indicator)
+  let kpIndex = 0;
+  let kpTimestamp = '';
+  if (kpRes.status === 'fulfilled' && Array.isArray(kpRes.value) && kpRes.value.length > 0) {
+    const latest = kpRes.value[kpRes.value.length - 1];
+    kpIndex = parseFloat(latest.kp_index || latest.Kp || 0);
+    kpTimestamp = latest.time_tag || '';
+  }
+
+  // Storm level from Kp
+  let stormLevel = 'Quiet';
+  let stormColor = '#00E676';
+  if (kpIndex >= 8) { stormLevel = 'Extreme (G5)'; stormColor = '#FF1744'; }
+  else if (kpIndex >= 7) { stormLevel = 'Severe (G4)'; stormColor = '#FF3D3D'; }
+  else if (kpIndex >= 6) { stormLevel = 'Strong (G3)'; stormColor = '#FF9500'; }
+  else if (kpIndex >= 5) { stormLevel = 'Moderate (G2)'; stormColor = '#FFD700'; }
+  else if (kpIndex >= 4) { stormLevel = 'Minor (G1)'; stormColor = '#FFD700'; }
+  else if (kpIndex >= 3) { stormLevel = 'Unsettled'; stormColor = '#D4AF37'; }
+
+  // Recent alerts
+  const alerts: any[] = [];
+  if (alertsRes.status === 'fulfilled' && Array.isArray(alertsRes.value)) {
+    for (const alert of alertsRes.value.slice(0, 10)) {
+      alerts.push({
+        id: alert.product_id || `alert-${Date.now()}`,
+        issue_datetime: alert.issue_datetime,
+        message: (alert.message || '').substring(0, 200),
+      });
+    }
+  }
+
+  // Recent solar flares
+  const flares: any[] = [];
+  if (flareRes.status === 'fulfilled' && Array.isArray(flareRes.value)) {
+    for (const flare of flareRes.value.slice(0, 5)) {
+      if (!flare.max_class) continue;
+      flares.push({
+        class: flare.max_class,
+        begin: flare.begin_time,
+        peak: flare.max_time,
+        end: flare.end_time,
+      });
+    }
+  }
+
+  const payload: SpaceWeatherPayload = {
+    kp_index: kpIndex,
+    storm_level: stormLevel,
+    storm_color: stormColor,
+    kp_timestamp: kpTimestamp,
+    alerts,
+    solar_flares: flares,
+    timestamp: new Date().toISOString(),
+  };
+
+  return { payload, ok };
+}
