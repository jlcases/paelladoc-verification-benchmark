 import { NextResponse } from 'next/server';
+import { readdirSync } from 'fs';
+import { join } from 'path';
+
+function scanApiRoutes(): string[] {
+  try {
+    const apiDir = join(process.cwd(), 'src', 'app', 'api');
+    const entries = readdirSync(apiDir, { recursive: true, encoding: 'utf-8' }) as string[];
+    return entries
+      .filter((entry) => entry === 'route.ts' || entry === 'route.js' || entry.endsWith('/route.ts') || entry.endsWith('/route.js'))
+      .map((entry) => {
+        const withoutFile = entry.replace(/[/\\]?route\.[jt]s$/, '');
+        const segment = withoutFile ? `/${withoutFile}` : '';
+        return `/api${segment}`;
+      })
+      .sort();
+  } catch {
+    return [];
+  }
+}
 
