+];
+
+function getFilterValues(searchParams: URLSearchParams, key: string): string[] {
+  return searchParams
+    .getAll(key)
+    .flatMap(value => value.split(','))
+    .map(value => value.trim().toLowerCase())
+    .filter(Boolean);
+}
+
+export async function GET(request: Request) {
+  const searchParams = new URL(request.url).searchParams;
+  const countries = getFilterValues(searchParams, 'country');
+  const categories = getFilterValues(searchParams, 'category');
+
+  const feeds = LIVE_FEEDS.filter(feed => {
+    const matchesCountry = countries.length === 0 || countries.includes(feed.country.toLowerCase());
+    const matchesCategory = categories.length === 0 || categories.includes(feed.category.toLowerCase());
+    return matchesCountry && matchesCategory;
+  });
+
+  return NextResponse.json({
+    feeds,
+    total: feeds.length,
+    categories: CATEGORIES,
+    timestamp: new Date().toISOString(),
+  }, {
     headers: { 'Cache-Control': 'public, s-maxage=86400, stale-while-revalidate=172800' },
   });
 }
