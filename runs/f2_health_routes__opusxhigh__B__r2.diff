diff --git a/scripts/generate-api-routes.mjs b/scripts/generate-api-routes.mjs
new file mode 100644
index 0000000..8d8fda4
--- /dev/null
+++ b/scripts/generate-api-routes.mjs
@@ -0,0 +1,69 @@
+// Scans the App Router API tree and writes src/lib/api-routes.generated.ts,
+// listing every Route Handler (one entry per `route.{ts,tsx,js,jsx}`).
+//
+// This keeps the /api/health endpoint list in sync with the real routes
+// without runtime filesystem access — important because the app is built with
+// `output: 'standalone'`, where source files are not present at runtime.
+//
+// Wired into `npm run build` / `npm run dev` via the prebuild/predev hooks.
+
+import { readdirSync, writeFileSync, mkdirSync } from 'node:fs';
+import { join, relative, sep, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const projectRoot = join(dirname(fileURLToPath(import.meta.url)), '..');
+const apiDir = join(projectRoot, 'src', 'app', 'api');
+const outFile = join(projectRoot, 'src', 'lib', 'api-routes.generated.ts');
+
+const ROUTE_FILE = /^route\.(?:ts|tsx|js|jsx|mjs)$/;
+
+/**
+ * Convert an api directory path into its public URL path, dropping route
+ * groups `(group)` and parallel-route slots `@slot`, which add no URL segment.
+ * @param {string} dir
+ * @returns {string}
+ */
+function toUrlPath(dir) {
+  const segments = relative(apiDir, dir)
+    .split(sep)
+    .filter(Boolean)
+    .filter((s) => !(s.startsWith('(') && s.endsWith(')')))
+    .filter((s) => !s.startsWith('@'));
+  return '/api' + (segments.length ? '/' + segments.join('/') : '');
+}
+
+/**
+ * @param {string} dir
+ * @param {string[]} routes
+ * @returns {string[]}
+ */
+function collect(dir, routes) {
+  const entries = readdirSync(dir, { withFileTypes: true });
+  if (entries.some((e) => e.isFile() && ROUTE_FILE.test(e.name))) {
+    routes.push(toUrlPath(dir));
+  }
+  for (const entry of entries) {
+    // Skip private folders (`_foo`), which opt out of routing.
+    if (entry.isDirectory() && !entry.name.startsWith('_')) {
+      collect(join(dir, entry.name), routes);
+    }
+  }
+  return routes;
+}
+
+const routes = Array.from(new Set(collect(apiDir, []))).sort();
+
+const body = `// AUTO-GENERATED by scripts/generate-api-routes.mjs — do not edit by hand.
+// Refresh with \`npm run build\` (or run the script directly).
+// One entry per Route Handler (\`route.ts\`) under src/app/api.
+
+export const API_ROUTES = [
+${routes.map((r) => `  '${r}',`).join('\n')}
+] as const;
+
+export type ApiRoute = (typeof API_ROUTES)[number];
+`;
+
+mkdirSync(dirname(outFile), { recursive: true });
+writeFileSync(outFile, body);
+console.log(`Generated ${relative(projectRoot, outFile)} with ${routes.length} routes.`);
