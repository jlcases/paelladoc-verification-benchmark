+import { readdir } from 'node:fs/promises';
+import path from 'node:path';
+import { NextResponse } from 'next/server';
+
+export const dynamic = 'force-dynamic';
+export const runtime = 'nodejs';
+
+const API_ROOT = path.join(process.cwd(), 'src', 'app', 'api');
+const ROUTE_FILE_PATTERN = /^route\.(?:js|jsx|ts|tsx)$/;
+
+function toEndpointPath(segments: string[]) {
+  const routeSegments = segments.filter((segment) => {
+    return !(segment.startsWith('(') && segment.endsWith(')'));
+  });
+
+  return `/api/${routeSegments.join('/')}`.replace(/\/$/, '');
+}
+
+async function discoverEndpoints(directory: string, segments: string[] = []): Promise<string[]> {
+  const entries = await readdir(directory, { withFileTypes: true });
+  const endpoints: string[] = [];
+
+  if (entries.some((entry) => entry.isFile() && ROUTE_FILE_PATTERN.test(entry.name))) {
+    endpoints.push(toEndpointPath(segments));
+  }
+
+  for (const entry of entries) {
+    if (!entry.isDirectory() || entry.name.startsWith('_')) {
+      continue;
+    }
+
+    endpoints.push(...await discoverEndpoints(path.join(directory, entry.name), [...segments, entry.name]));
+  }
+
+  return endpoints;
+}
+
+async function getApiEndpoints() {
+  try {
+    const endpoints = await discoverEndpoints(API_ROOT);
+    return endpoints
+      .filter((endpoint) => endpoint.startsWith('/api/'))
+      .sort();
+  } catch {
+    return [];
+  }
+}
+
+export async function GET() {
+  const endpoints = await getApiEndpoints();
+
+  return NextResponse.json({
+    status: 'operational',
+    platform: 'OSIRIS',
+    version: '1.0.0',
+    uptime: process.uptime ? Math.round(process.uptime()) : 0,
+    timestamp: new Date().toISOString(),
+    endpoints,
+  });
+}
