+import { readdir } from 'fs/promises';
+import { join } from 'path';
+import { NextResponse } from 'next/server';
+
+export const dynamic = 'force-dynamic';
+export const runtime = 'nodejs';
+
+const API_ROUTES_DIR = join(process.cwd(), 'src', 'app', 'api');
+const ROUTE_FILE_NAMES = new Set([
+  'route.ts',
+  'route.tsx',
+  'route.js',
+  'route.jsx',
+  'route.mjs',
+  'route.cjs',
+]);
+
+function routeSegmentToPathPart(segment: string): string | null {
+  if (segment.startsWith('(') && segment.endsWith(')')) {
+    return null;
+  }
+
+  if (segment.startsWith('@')) {
+    return null;
+  }
+
+  return segment;
+}
+
+function apiPathFromSegments(segments: string[]): string {
+  return `/api/${segments.join('/')}`;
+}
+
+async function collectApiEndpoints(
+  directory: string,
+  segments: string[] = [],
+): Promise<string[]> {
+  const entries = await readdir(directory, { withFileTypes: true });
+  const endpoints: string[] = [];
+
+  if (entries.some((entry) => entry.isFile() && ROUTE_FILE_NAMES.has(entry.name))) {
+    endpoints.push(apiPathFromSegments(segments));
+  }
+
+  for (const entry of entries) {
+    if (!entry.isDirectory() || entry.name.startsWith('_')) {
+      continue;
+    }
+
+    const pathPart = routeSegmentToPathPart(entry.name);
+    const childSegments = pathPart === null ? segments : [...segments, pathPart];
+    endpoints.push(...(await collectApiEndpoints(join(directory, entry.name), childSegments)));
+  }
+
+  return endpoints;
+}
+
+async function discoverApiEndpoints(): Promise<string[]> {
+  try {
+    const endpoints = await collectApiEndpoints(API_ROUTES_DIR);
+    return [...new Set(endpoints)]
+      .filter((endpoint) => endpoint.startsWith('/api/'))
+      .sort();
+  } catch {
+    return [];
+  }
+}
+
+export async function GET() {
+  const endpoints = await discoverApiEndpoints();
+
+  return NextResponse.json({
+    status: 'operational',
+    platform: 'OSIRIS',
+    version: '1.0.0',
+    uptime: process.uptime ? Math.round(process.uptime()) : 0,
+    timestamp: new Date().toISOString(),
+    endpoints,
+  }, { status: 200 });
+}
